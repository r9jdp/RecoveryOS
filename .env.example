# Application
APP_ENV=development
DEMO_MODE=true
API_HOST=0.0.0.0
API_PORT=8000
# Exact comma-separated browser origins only; credentialed CORS rejects wildcards.
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Local mock credentials only; real-action mode rejects these defaults.
OPERATOR_DEMO_EMAIL=demo@recoveryos.dev
OPERATOR_DEMO_TOKEN=recovery-demo
OPERATOR_SESSION_SECRET=recoveryos-local-session-v1
OPERATOR_COOKIE_SECURE=false
# lax is the safe local/same-site default. Separate hosted frontend/API sites
# must use none together with Secure=true.
OPERATOR_COOKIE_SAMESITE=lax
OPERATOR_AUTH_REQUIRED=false

# Supabase PostgreSQL (Dashboard -> Connect -> Session pooler, port 5432)
# Use postgresql+psycopg:// and append sslmode=require. Keep this server-side.
DATABASE_URL=

# Temporal Cloud
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_TASK_QUEUE=recovery-os
TEMPORAL_TLS=true
TEMPORAL_API_KEY=
HEALTHCHECK_TIMEOUT_SECONDS=3
# Worker activities stay deterministic/mock unless production persistence is
# selected explicitly. Razorpay execution requires both flags plus test keys.
RECOVERY_ACTIVITY_MODE=mock
RECOVERY_ALLOW_REAL_PAYMENT_ACTIONS=false

# Payment provider (mock is always the safe default)
PAYMENT_PROVIDER=mock
RECOVERY_GLOBAL_KILL_SWITCH=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com
RAZORPAY_CHECKOUT_ORIGIN=http://localhost:3000
RAZORPAY_OUTBOX_POLL_SECONDS=0.5
RAZORPAY_TEST_MODE_REQUIRED=true

# A2A
A2A_ENABLED=false
RECOVERY_AGENT_ORIGIN=http://localhost:8000
CUSTOMER_AGENT_ORIGIN=http://localhost:8010
CUSTOMER_AGENT_WEB_ORIGIN=http://localhost:3000
CUSTOMER_AGENT_SIGNER_KEY_ID=customer-agent-key-1
# Base64url-encoded 32-byte Ed25519 seed. Keep server-side and disabled by default.
CUSTOMER_AGENT_ED25519_PRIVATE_KEY=
CUSTOMER_AGENT_REAL_SIGNING_ENABLED=false
CUSTOMER_AGENT_REQUEST_TTL_SECONDS=900
# Hosted staging/production selects sql; memory remains the safe local default.
CUSTOMER_AGENT_TASK_STORE=memory
# Server-only. Required when CUSTOMER_AGENT_TASK_STORE=sql.
CUSTOMER_AGENT_DATABASE_URL=
# JSON object mapping signer_key_id to a base64url-encoded raw Ed25519 public key.
CUSTOMER_AGENT_PUBLIC_KEYS_JSON={}
# Recovery-agent receipts are signed even in mock mode. Hosted environments must use configured
# signing and pin the matching public key in the customer-agent process.
RECOVERY_AGENT_RECEIPT_SIGNING_MODE=mock
RECOVERY_AGENT_RECEIPT_SIGNER_KEY_ID=recovery-agent-receipt-key-1
# Base64url-encoded 32-byte Ed25519 seed; server-side worker secret only.
RECOVERY_AGENT_RECEIPT_ED25519_PRIVATE_KEY=
CUSTOMER_AGENT_RECEIPT_VERIFICATION_MODE=mock
# JSON object mapping recovery receipt signer_key_id to raw Ed25519 public key, customer-agent only.
CUSTOMER_AGENT_RECOVERY_AGENT_PUBLIC_KEYS_JSON={}

# Voice (real telephony remains operator-only and disabled by default)
VOICE_PROVIDER=mock
VOICE_REAL_CALLS_ENABLED=false
VOICE_OPERATOR_TOKEN=
# Server-side comma-separated destination tokens for pre-consented, team-owned numbers.
VOICE_ALLOWLIST_DESTINATIONS=
VOICE_PUBLIC_ORIGIN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
VOICE_MAX_CONCURRENT_CALLS=1
VOICE_MAX_CALL_SECONDS=180
VOICE_DAILY_CALL_LIMIT=10

# Models
MODEL_DIR=./ml/artifacts
RECOVERY_MODEL_VERSION=rules-v1
INTENT_MODEL_VERSION=rules-v1
# Optional; unset uses the checked-in deterministic RecoveryBench report/fallback scorer.
RECOVERYBENCH_ARTIFACT_DIR=./ml/recoverybench/artifacts/recoverybench.v1

# Optional wording adapter
LLM_PROVIDER=mock
LLM_API_KEY=

# Logging
LOG_LEVEL=INFO
