# Application
APP_ENV=development
DEMO_MODE=true
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
OPERATOR_DEMO_TOKEN=change-me-locally

# Database
DATABASE_URL=postgresql+psycopg://recovery:recovery@localhost:55432/recovery_os

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=recovery-os
TEMPORAL_TLS=false
TEMPORAL_API_KEY=
HEALTHCHECK_TIMEOUT_SECONDS=3

# Payment provider (mock is always the safe default)
PAYMENT_PROVIDER=mock
RECOVERY_GLOBAL_KILL_SWITCH=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com
RAZORPAY_CHECKOUT_ORIGIN=http://localhost:3000
RAZORPAY_OUTBOX_POLL_SECONDS=0.5
RAZORPAY_TEST_MODE_REQUIRED=true

# A2A
A2A_ENABLED=false
RECOVERY_AGENT_ORIGIN=http://localhost:8000
CUSTOMER_AGENT_ORIGIN=http://localhost:8010
CUSTOMER_AGENT_WEB_ORIGIN=http://localhost:3000
CUSTOMER_AGENT_SIGNER_KEY_ID=customer-agent-key-1
# Base64url-encoded 32-byte Ed25519 seed. Keep server-side and disabled by default.
CUSTOMER_AGENT_ED25519_PRIVATE_KEY=
CUSTOMER_AGENT_REAL_SIGNING_ENABLED=false
CUSTOMER_AGENT_REQUEST_TTL_SECONDS=900
# JSON object mapping signer_key_id to a base64url-encoded raw Ed25519 public key.
CUSTOMER_AGENT_PUBLIC_KEYS_JSON={}

# Voice (real telephony remains operator-only and disabled by default)
VOICE_PROVIDER=mock
VOICE_REAL_CALLS_ENABLED=false
VOICE_OPERATOR_TOKEN=
# Server-side comma-separated destination tokens for pre-consented, team-owned numbers.
VOICE_ALLOWLIST_DESTINATIONS=
VOICE_PUBLIC_ORIGIN=http://localhost:8000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
VOICE_MAX_CONCURRENT_CALLS=1
VOICE_MAX_CALL_SECONDS=180
VOICE_DAILY_CALL_LIMIT=10

# Models
MODEL_DIR=./ml/artifacts
RECOVERY_MODEL_VERSION=rules-v1
INTENT_MODEL_VERSION=rules-v1
# Optional; unset uses the checked-in deterministic RecoveryBench report/fallback scorer.
RECOVERYBENCH_ARTIFACT_DIR=./ml/recoverybench/artifacts/recoverybench.v1

# Optional wording adapter
LLM_PROVIDER=mock
LLM_API_KEY=

# Logging
LOG_LEVEL=INFO
