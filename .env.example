# Application
APP_ENV=development
DEMO_MODE=true
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
OPERATOR_DEMO_TOKEN=change-me-locally

# Database
DATABASE_URL=postgresql+psycopg://recovery:recovery@localhost:55432/recovery_os

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=recovery-os
TEMPORAL_TLS=false
TEMPORAL_API_KEY=
HEALTHCHECK_TIMEOUT_SECONDS=3

# Payment provider (mock is always the safe default)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TEST_MODE_REQUIRED=true

# A2A
A2A_ENABLED=false
RECOVERY_AGENT_BASE_URL=http://localhost:8000
CUSTOMER_AGENT_BASE_URL=http://localhost:8010
MANDATE_SIGNING_PRIVATE_KEY=
MANDATE_VERIFY_PUBLIC_KEY=
MANDATE_KEY_ID=customer-agent-key-1

# Voice (real telephony remains operator-only and disabled by default)
VOICE_PROVIDER=mock
REAL_TELEPHONY_ENABLED=false
VOICE_ALLOWLIST_E164=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
VOICE_MAX_CONCURRENT_CALLS=1
VOICE_MAX_CALL_SECONDS=180
VOICE_DAILY_CALL_LIMIT=10

# Models
MODEL_DIR=./ml/artifacts
RECOVERY_MODEL_VERSION=rules-v1
INTENT_MODEL_VERSION=rules-v1

# Optional wording adapter
LLM_PROVIDER=mock
LLM_API_KEY=

# Logging
LOG_LEVEL=INFO
