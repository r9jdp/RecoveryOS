{
  "name": "recovery-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile=false && uv sync --all-groups",
    "dev": "pnpm --parallel --stream --filter @recovery-os/web dev",
    "dev:web": "pnpm --filter @recovery-os/web dev",
    "dev:api": "uv run uvicorn services.api.app.main:app --reload --host 0.0.0.0 --port 8000",
    "dev:worker": "uv run python -m services.worker.app.main",
    "dev:customer-agent": "uv run uvicorn app.main:app --app-dir services/customer-agent --reload --host 0.0.0.0 --port 8010",
    "infra": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "migrate": "uv run alembic -c services/api/alembic.ini upgrade head",
    "seed": "uv run python -m services.api.app.seed",
    "reset": "uv run python -m services.api.app.seed --reset",
    "lint": "pnpm lint:web && uv run ruff check .",
    "lint:web": "pnpm --filter @recovery-os/web lint",
    "format:check": "pnpm --filter @recovery-os/web format:check && uv run ruff format --check .",
    "typecheck": "pnpm typecheck:web && uv run mypy services packages ml",
    "typecheck:web": "pnpm --filter @recovery-os/web typecheck",
    "test": "pnpm test:web && uv run pytest",
    "test:web": "pnpm --filter @recovery-os/web test",
    "e2e": "pnpm --filter @recovery-os/web e2e",
    "e2e:service": "node scripts/e2e/run-service-stack.mjs",
    "build": "pnpm --filter @recovery-os/web build",
    "generate:openapi": "uv run python scripts/export_openapi.py",
    "generate:client": "pnpm --filter @recovery-os/web generate:client",
    "generate:data": "uv run python -m ml.recoverybench.build",
    "train": "uv run python -m ml.recoverybench.build",
    "evaluate": "uv run python -m ml.recoverybench.build"
  }
}
