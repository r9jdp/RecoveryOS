#cloud-config
package_update: true
package_upgrade: true

packages:
  - ca-certificates
  - curl
  - docker.io
  - docker-compose-v2
  - git
  - jq
  - postgresql-client
  - util-linux
  - unattended-upgrades
  - ufw

users:
  - default
  - name: recoveryos
    groups: [docker, sudo]
    lock_passwd: true
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
      - ${ssh_public_key_json}

write_files:
  - path: /etc/sysctl.d/60-recoveryos.conf
    permissions: "0644"
    content: |
      net.ipv4.ip_forward=1
      net.ipv4.conf.all.accept_redirects=0
      net.ipv4.conf.default.accept_redirects=0
      net.ipv4.conf.all.send_redirects=0
      net.ipv4.conf.default.send_redirects=0

runcmd:
  - [systemctl, enable, --now, docker]
  - [install, -d, -m, "0755", -o, recoveryos, -g, recoveryos, /opt/recoveryos]
  - [install, -d, -m, "0750", -o, recoveryos, -g, recoveryos, /var/lib/recoveryos]
  - [install, -d, -m, "0750", -o, root, -g, recoveryos, /etc/recoveryos]
  - [ufw, default, deny, incoming]
  - [ufw, default, allow, outgoing]
  - [ufw, allow, 22/tcp]
  - [ufw, allow, 80/tcp]
  - [ufw, allow, 443/tcp]
  - [ufw, allow, 443/udp]
  - [ufw, --force, enable]
  - [sysctl, --system]

final_message: "RecoveryOS host bootstrap complete. Verify Docker and harden SSH before deployment."
